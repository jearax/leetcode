{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "dist",
		"rootDir": "src",
		"removeComments": false
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "test/**/*", "**/*.test.ts", "vitest.config.ts"]
}