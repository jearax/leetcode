{
  "java.compile.nullAnalysis.mode": "automatic",
  "java.configuration.updateBuildConfiguration": "automatic",

  // Dùng đúng Google Style cho format-on-save — khớp với Spotless
  // (Google Java Format) trong ./gradlew build. Không có 2 dòng này,
  // extension Java format kiểu Eclipse 4-space và spotlessCheck fail.
  "java.format.settings.url": "./apps/java-spring-leetcode/config/eclipse-java-google-style.xml",
  "java.format.settings.profile": "GoogleStyle"
}