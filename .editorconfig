root = true

# Toàn repo: indent bằng TAB, 1 tab = 2 space.
# Java: formatter thật sự là config/eclipse-java-format.xml (dùng chung
# Spotless + VS Code) — .editorconfig này nhất quán với nó.
[*]
indent_style = tab
indent_size = 2
tab_width = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.java]
indent_style = space
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab